# =========================================================================
# ConectaJAC - Variables de Entorno Globales del Monorepo
# =========================================================================

# Entorno de Ejecución
NODE_ENV=development
PORT=4000

# Base de Datos MongoDB Atlas
DATABASE_URL=mongodb+srv://juanpabloporraslozano_db_user:wDQGuHyBZ0s1CoTX@<cluster-host>.mongodb.net/conectajac_db?retryWrites=true&w=majority

# Redis (Caché, Rate Limiting y Colas BullMQ de Notificaciones)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Autenticación JWT y Tokens Criptográficos
JWT_SECRET=conectajac_jwt_super_secret_development_key_32_chars_min
JWT_EXPIRES_IN=86400
JWT_REFRESH_SECRET=conectajac_refresh_token_super_secret_key_32_chars_min
JWT_REFRESH_EXPIRES_IN=604800

# Voto Secreto en Asambleas (AES-256 Encryption Key)
SECRET_BALLOT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Pasarela de Pagos Wompi (Recaudo Comunal PSE, Bancolombia, Nequi)
WOMPI_PUBLIC_KEY=pub_test_X1y2Z3...
WOMPI_PRIVATE_KEY=prv_test_A1b2C3...
WOMPI_INTEGRITY_SECRET=test_integrity_secret_32_chars...
WOMPI_EVENTS_SECRET=test_events_checksum_secret...
WOMPI_ENVIRONMENT=sandbox

# Notificaciones Multicanal Veredales
# 1. WhatsApp Business Cloud API (Meta Graph API)
WHATSAPP_CLOUD_API_TOKEN=EAA...
WHATSAPP_PHONE_NUMBER_ID=109876543210
WHATSAPP_VERIFY_TOKEN=conectajac_webhook_verification_token

# 2. Notificaciones Push (Expo Server API)
EXPO_ACCESS_TOKEN=exp_token_...

# URLs Públicas de Clientes
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
