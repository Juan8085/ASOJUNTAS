datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/client"
}

// =========================================================================
// ENUMS
// =========================================================================

enum UserRole {
  SUPER_ADMIN        // Asojuntas / Administrador Municipal
  JAC_ADMIN          // Administrador General de JAC
  JAC_PRESIDENT      // Presidente de la Junta
  JAC_VICE_PRESIDENT // Vicepresidente
  JAC_SECRETARY      // Secretario(a) (Custodio del Libro de Afiliados)
  JAC_TREASURER      // Tesorero(a) (Gestor de Cuentas y Pagos)
  JAC_FISCAL         // Fiscal (Auditor interno)
  CITIZEN            // Habitante / Afiliado de Vereda o Barrio
}

enum IdentificationType {
  CC       // Cédula de Ciudadanía
  TI       // Tarjeta de Identidad
  CE       // Cédula de Extranjería
  PASSPORT // Pasaporte
  PPT      // Permiso por Protección Temporal
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DECEASED
}

enum CertificateType {
  RESIDENCE     // Certificado de Residencia
  AFFILIATION   // Certificado de Afiliación
  GOOD_STANDING // Paz y Salvo Comunal
}

enum CertificateStatus {
  VALID
  REVOKED
  EXPIRED
}

enum FeeType {
  ORDINARY           // Cuota ordinaria de sostenimiento
  EXTRAORDINARY      // Cuota extraordinaria (obras comunales)
  COMMUNAL_WORK_FINE // Compensación monetaria por inasistencia a Minga
  EVENT              // Aporte para bazar/evento comunal
}

enum FeePeriodicity {
  ONE_TIME
  MONTHLY
  BIMONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
}

enum ObligationStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
}

enum PaymentGateway {
  WOMPI
  MERCADOPAGO
  EPAYCO
  MANUAL_CASH
}

enum PaymentMethod {
  PSE
  NEQUI
  DAVIPLATA
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum TreasuryAccountType {
  CASH_BOX       // Caja menor en efectivo
  BANK_SAVINGS   // Cuenta de Ahorros Bancaria
  BANK_CHECKING  // Cuenta Corriente
  DIGITAL_WALLET // Billetera Digital (Nequi / Daviplata institucional)
}

enum TreasuryTransactionType {
  INCOME
  EXPENSE
}

enum TreasuryCategory {
  AFFILIATION_FEE
  MONTHLY_FEE
  EXTRAORDINARY_FEE
  COMMUNAL_HALL_RENT
  DONATION
  MUNICIPAL_SUBSIDY
  EVENT_PROCEEDS
  COMMUNAL_WORKS
  OFFICE_SUPPLIES
  MAINTENANCE
  LEGAL_SERVICES
  OTHER
}

enum MarketUnit {
  KG
  LIBRA
  BULTO
  ARROBA
  UNIDAD
  MANOJO
  LITRO
  BOTELLA
}

enum MarketOrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP_AT_FARM
  LOCAL_DELIVERY
  COMMUNITY_HUB_PICKUP
  WHATSAPP_COORDINATION
}

enum PostScope {
  MUNICIPAL_ASOJUNTAS // Visible para todo el municipio
  JAC_LOCAL           // Exclusivo de la vereda/barrio de la JAC
}

enum PostType {
  NEWS
  OFFICIAL_CIRCULAR
  COMMUNAL_WORK      // Convocatoria a Minga comunitaria
  EMERGENCY_ALERT    // Alerta de derrumbe, vía cerrada, clima
  EVENT
}

enum PostPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PqrsdType {
  PETITION
  COMPLAINT
  CLAIM
  SUGGESTION
  REPORT
}

enum PqrsdStatus {
  RECEIVED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
}

enum AssemblyType {
  ORDINARY
  EXTRAORDINARY
}

enum AssemblyStatus {
  SCHEDULED
  IN_PROGRESS
  QUORUM_FAILED
  FINISHED
  CANCELLED
}

enum NotificationChannel {
  PUSH
  WHATSAPP
  SMS
  EMAIL
  IN_APP
}

// =========================================================================
// 1. ORGANIZACIÓN Y MULTI-TENANCY (NIVEL 1 & 2)
// =========================================================================

model Municipality {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  department String
  daneCode   String      @unique @map("dane_code")
  createdAt  DateTime    @default(now()) @map("created_at")
  asojuntas  Asojuntas[]
  jacs       Jac[]

  @@map("municipalities")
}

model Asojuntas {
  id                    String       @id @default(auto()) @map("_id") @db.ObjectId
  municipalityId        String       @map("municipality_id") @db.ObjectId
  name                  String
  nit                   String       @unique
  legalPersonhoodNumber String       @map("legal_personhood_number")
  email                 String?
  phone                 String?
  address               String?
  isActive              Boolean      @default(true) @map("is_active")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  municipality          Municipality @relation(fields: [municipalityId], references: [id], onDelete: NoAction)
  jacs                  Jac[]

  @@map("asojuntas")
}

model Jac {
  id                    String                @id @default(auto()) @map("_id") @db.ObjectId
  municipalityId        String                @map("municipality_id") @db.ObjectId
  asojuntasId           String?               @map("asojuntas_id") @db.ObjectId
  name                  String
  legalPersonhoodNumber String                @map("legal_personhood_number")
  nit                   String?               @unique
  codeRup               String?               @unique @map("code_rup") // Registro Único Comunal
  veredaOrBarrio        String                @map("vereda_or_barrio")
  address               String?
  latitude              Float?
  longitude             Float?
  phone                 String?
  email                 String?
  logoUrl               String?               @map("logo_url")
  officialSealUrl       String?               @map("official_seal_url")
  primaryColor          String                @default("#059669") @map("primary_color")
  bankAccounts          Json                  @default("[]") @map("bank_accounts")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  municipality          Municipality          @relation(fields: [municipalityId], references: [id], onDelete: NoAction)
  asojuntas             Asojuntas?            @relation(fields: [asojuntasId], references: [id], onDelete: SetNull)

  memberships           JacMembership[]
  certificates          Certificate[]
  feeConfigurations     FeeConfiguration[]
  userFeeObligations    UserFeeObligation[]
  paymentTransactions   PaymentTransaction[]
  treasuryAccounts      TreasuryAccount[]
  treasuryTransactions  TreasuryTransaction[]
  producers             ProducerProfile[]
  marketProducts        MarketProduct[]
  marketOrders          MarketOrder[]
  posts                 Post[]
  mingaAttendances      MingaAttendance[]
  pqrsdTickets          PqrsdTicket[]
  assemblies            Assembly[]
  assemblyTopics        AssemblyTopic[]
  assemblyVoteRecords   AssemblyVoteRecord[]
  auditLogs             AuditLog[]
  notifications         Notification[]

  @@index([municipalityId])
  @@index([asojuntasId])
  @@map("jacs")
}

// =========================================================================
// 2. USUARIOS, IDENTIDAD Y LIBRO DE AFILIADOS (RBAC)
// =========================================================================

model User {
  id                   String                @id @default(auto()) @map("_id") @db.ObjectId
  identificationType   IdentificationType    @default(CC) @map("identification_type")
  identificationNumber String                @unique @map("identification_number")
  firstName            String                @map("first_name")
  lastName             String                @map("last_name")
  email                String?               @unique
  phone                String
  birthDate            DateTime?             @map("birth_date")
  gender               String?
  avatarUrl            String?               @map("avatar_url")
  passwordHash         String                @map("password_hash")
  latitude             Float?
  longitude            Float?
  isEmailVerified      Boolean               @default(false) @map("is_email_verified")
  isPhoneVerified      Boolean               @default(false) @map("is_phone_verified")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  memberships          JacMembership[]
  issuedCertificates   Certificate[]         @relation("IssuedCertificates")
  receivedCertificates Certificate[]         @relation("ReceivedCertificates")
  feeObligations       UserFeeObligation[]
  paymentTransactions  PaymentTransaction[]
  registeredMovements  TreasuryTransaction[]
  producerProfile      ProducerProfile?
  marketOrders         MarketOrder[]
  authoredPosts        Post[]
  mingaAttendances     MingaAttendance[]
  pqrsdTickets         PqrsdTicket[]         @relation("CitizenTickets")
  assignedTickets      PqrsdTicket[]         @relation("AssignedTickets")
  assemblyVoteRecords  AssemblyVoteRecord[]
  auditLogs            AuditLog[]
  notifications        Notification[]

  @@index([phone])
  @@map("users")
}

model JacMembership {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  jacId                String           @map("jac_id") @db.ObjectId
  userId               String           @map("user_id") @db.ObjectId
  role                 UserRole         @default(CITIZEN)
  status               MembershipStatus @default(ACTIVE)
  
  // Datos formales del Libro Digital de Afiliados (Ley 2166 de 2021)
  bookNumber           Int              @default(1) @map("book_number")
  folioNumber          Int              @map("folio_number")
  affiliationDate      DateTime         @default(now()) @map("affiliation_date")
  disaffiliationDate   DateTime?        @map("disaffiliation_date")
  disaffiliationReason String?          @map("disaffiliation_reason")
  
  // Datos socioeconómicos veredales
  address              String
  veredaOrBarrio       String           @map("vereda_or_barrio")
  occupation           String?
  hasLandOrFarm        Boolean          @default(false) @map("has_land_or_farm")
  farmName             String?          @map("farm_name")
  latitude             Float?
  longitude            Float?
  observations         String?
  
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  jac                  Jac              @relation(fields: [jacId], references: [id], onDelete: Cascade)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jacId, userId])
  @@unique([jacId, bookNumber, folioNumber])
  @@index([jacId])
  @@index([userId])
  @@index([role])
  @@map("jac_memberships")
}

// =========================================================================
// 3. CERTIFICADOS DIGITALES CON QR VERIFICABLE
// =========================================================================

model Certificate {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  jacId            String            @map("jac_id") @db.ObjectId
  userId           String            @map("user_id") @db.ObjectId
  issuedByUserId   String            @map("issued_by_user_id") @db.ObjectId
  type             CertificateType
  status           CertificateStatus @default(VALID)
  
  verificationCode String            @unique @map("verification_code")
  qrSecurityToken  String            @unique @map("qr_security_token")
  pdfUrl           String?           @map("pdf_url")
  purpose          String
  
  issuedAt         DateTime          @default(now()) @map("issued_at")
  validUntil       DateTime          @map("valid_until")
  metadata         Json              @default("{}") // Datos congelados al momento de expedir
  
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  jac              Jac               @relation(fields: [jacId], references: [id], onDelete: Cascade)
  user             User              @relation("ReceivedCertificates", fields: [userId], references: [id], onDelete: NoAction)
  issuedBy         User              @relation("IssuedCertificates", fields: [issuedByUserId], references: [id], onDelete: NoAction)

  @@index([jacId])
  @@index([userId])
  @@map("certificates")
}

// =========================================================================
// 4. TESORERÍA, CUOTAS Y PAGOS (ADAPTER / STRATEGY)
// =========================================================================

model FeeConfiguration {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  jacId       String              @map("jac_id") @db.ObjectId
  name        String
  description String?
  type        FeeType
  periodicity FeePeriodicity
  amount      Float
  dueDateDay  Int                 @default(15) @map("due_date_day")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  jac         Jac                 @relation(fields: [jacId], references: [id], onDelete: Cascade)
  obligations UserFeeObligation[]

  @@index([jacId])
  @@map("fee_configurations")
}

model UserFeeObligation {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  jacId               String               @map("jac_id") @db.ObjectId
  userId              String               @map("user_id") @db.ObjectId
  feeConfigId         String               @map("fee_config_id") @db.ObjectId
  period              String               // Ej: "2026-03", "2026-ANUAL"
  amount              Float
  paidAmount          Float                @default(0.00) @map("paid_amount")
  status              ObligationStatus     @default(PENDING)
  dueDate             DateTime             @map("due_date")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  jac                 Jac                  @relation(fields: [jacId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeConfig           FeeConfiguration     @relation(fields: [feeConfigId], references: [id], onDelete: NoAction)
  paymentTransactions PaymentTransaction[]

  @@unique([jacId, userId, feeConfigId, period])
  @@index([jacId])
  @@index([userId])
  @@index([status])
  @@map("user_fee_obligations")
}

model PaymentTransaction {
  id                   String                @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey       String                @unique @map("idempotency_key")
  jacId                String                @map("jac_id") @db.ObjectId
  userId               String                @map("user_id") @db.ObjectId
  feeObligationId      String?               @map("fee_obligation_id") @db.ObjectId
  marketOrderId        String?               @map("market_order_id") @db.ObjectId
  
  amount               Float
  currency             String                @default("COP")
  gateway              PaymentGateway
  paymentMethod        PaymentMethod         @map("payment_method")
  status               PaymentStatus         @default(PENDING)
  
  gatewayTransactionId String?               @map("gateway_transaction_id")
  gatewayReference     String?               @map("gateway_reference")
  gatewaySignature     String?               @map("gateway_signature")
  webhookPayload       Json?                 @map("webhook_payload")
  receiptNumber        String?               @map("receipt_number")
  voucherUrl           String?               @map("voucher_url")
  paidAt               DateTime?             @map("paid_at")
  metadata             Json                  @default("{}")
  
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  jac                  Jac                   @relation(fields: [jacId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: NoAction)
  feeObligation        UserFeeObligation?    @relation(fields: [feeObligationId], references: [id], onDelete: SetNull)
  marketOrder          MarketOrder?          @relation(fields: [marketOrderId], references: [id], onDelete: SetNull)
  treasuryTransactions TreasuryTransaction[]

  @@index([jacId])
  @@index([userId])
  @@index([gatewayTransactionId])
  @@index([status])
  @@map("payment_transactions")
}

model TreasuryAccount {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  jacId         String                @map("jac_id") @db.ObjectId
  name          String
  type          TreasuryAccountType
  balance       Float                 @default(0.00)
  accountNumber String?               @map("account_number")
  isActive      Boolean               @default(true) @map("is_active")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  jac           Jac                   @relation(fields: [jacId], references: [id], onDelete: Cascade)
  movements     TreasuryTransaction[]

  @@index([jacId])
  @@map("treasury_accounts")
}

model TreasuryTransaction {
  id                   String                  @id @default(auto()) @map("_id") @db.ObjectId
  jacId                String                  @map("jac_id") @db.ObjectId
  accountId            String                  @map("account_id") @db.ObjectId
  registeredByUserId   String                  @map("registered_by_user_id") @db.ObjectId
  paymentTransactionId String?                 @map("payment_transaction_id") @db.ObjectId
  
  type                 TreasuryTransactionType
  category             TreasuryCategory
  amount               Float
  balanceAfter         Float                   @map("balance_after")
  description          String
  voucherUrl           String?                 @map("voucher_url")
  transactionDate      DateTime                @default(now()) @map("transaction_date")
  createdAt            DateTime                @default(now()) @map("created_at")

  jac                  Jac                     @relation(fields: [jacId], references: [id], onDelete: Cascade)
  account              TreasuryAccount         @relation(fields: [accountId], references: [id], onDelete: NoAction)
  registeredBy         User                    @relation(fields: [registeredByUserId], references: [id], onDelete: NoAction)
  paymentTransaction   PaymentTransaction?     @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@index([jacId])
  @@index([accountId])
  @@index([type])
  @@index([category])
  @@map("treasury_transactions")
}

// =========================================================================
// 5. MERCADO CAMPESINO (CATÁLOGO RURAL Y COMERCIO COMUNITARIO)
// =========================================================================

model ProducerProfile {
  id                    String          @id @default(auto()) @map("_id") @db.ObjectId
  userId                String          @unique @map("user_id") @db.ObjectId
  jacId                 String          @map("jac_id") @db.ObjectId
  farmName              String          @map("farm_name")
  veredaName            String          @map("vereda_name")
  bio                   String?
  whatsappContact       String          @map("whatsapp_contact")
  isVerified            Boolean         @default(false) @map("is_verified")
  rating                Float           @default(5.00)
  bannerImageUrl        String?         @map("banner_image_url")
  acceptsOnlinePayment  Boolean         @default(true) @map("accepts_online_payment")
  acceptsCashOnDelivery Boolean         @default(true) @map("accepts_cash_on_delivery")
  isActive              Boolean         @default(true) @map("is_active")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jac                   Jac             @relation(fields: [jacId], references: [id], onDelete: NoAction)
  products              MarketProduct[]
  orders                MarketOrder[]

  @@index([jacId])
  @@map("producer_profiles")
}

model MarketCategory {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  name         String          @unique
  slug         String          @unique
  iconUrl      String?         @map("icon_url")
  displayOrder Int             @default(0) @map("display_order")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")

  products     MarketProduct[]

  @@map("market_categories")
}

model MarketProduct {
  id                   String            @id @default(auto()) @map("_id") @db.ObjectId
  producerId           String            @map("producer_id") @db.ObjectId
  jacId                String            @map("jac_id") @db.ObjectId
  categoryId           String            @map("category_id") @db.ObjectId
  
  title                String
  description          String
  price                Float
  unit                 MarketUnit
  stockQuantity        Float             @default(0.00) @map("stock_quantity")
  images               Json              @default("[]")
  isOrganic            Boolean           @default(false) @map("is_organic")
  harvestDate          DateTime?         @map("harvest_date")
  
  availableForDelivery Boolean           @default(true) @map("available_for_delivery")
  availableForPickup   Boolean           @default(true) @map("available_for_pickup")
  isAvailable          Boolean           @default(true) @map("is_available")
  
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  producer             ProducerProfile   @relation(fields: [producerId], references: [id], onDelete: Cascade)
  jac                  Jac               @relation(fields: [jacId], references: [id], onDelete: NoAction)
  category             MarketCategory    @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  orderItems           MarketOrderItem[]

  @@index([jacId])
  @@index([producerId])
  @@index([categoryId])
  @@index([isAvailable])
  @@map("market_products")
}

model MarketOrder {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber         String               @unique @map("order_number")
  producerId          String               @map("producer_id") @db.ObjectId
  jacId               String               @map("jac_id") @db.ObjectId
  buyerUserId         String?              @map("buyer_user_id") @db.ObjectId
  
  buyerName           String               @map("buyer_name")
  buyerPhone          String               @map("buyer_phone")
  deliveryMethod      DeliveryMethod       @map("delivery_method")
  deliveryAddress     String?              @map("delivery_address")
  status              MarketOrderStatus    @default(PENDING_CONFIRMATION)
  totalAmount         Float                @map("total_amount")
  paymentMethod       PaymentMethod        @map("payment_method")
  customerNotes       String?              @map("customer_notes")
  
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  producer            ProducerProfile      @relation(fields: [producerId], references: [id], onDelete: NoAction)
  jac                 Jac                  @relation(fields: [jacId], references: [id], onDelete: NoAction)
  buyerUser           User?                @relation(fields: [buyerUserId], references: [id], onDelete: SetNull)
  items               MarketOrderItem[]
  paymentTransactions PaymentTransaction[]

  @@index([producerId])
  @@index([jacId])
  @@index([buyerUserId])
  @@index([status])
  @@map("market_orders")
}

model MarketOrderItem {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId      String        @map("order_id") @db.ObjectId
  productId    String        @map("product_id") @db.ObjectId
  productTitle String        @map("product_title")
  quantity     Float
  unitPrice    Float         @map("unit_price")
  subtotal     Float

  order        MarketOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      MarketProduct @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@index([orderId])
  @@index([productId])
  @@map("market_order_items")
}

// =========================================================================
// 6. NOTICIAS, COMUNICACIONES Y MINGAS
// =========================================================================

model Post {
  id                             String            @id @default(auto()) @map("_id") @db.ObjectId
  jacId                          String?           @map("jac_id") @db.ObjectId
  authorUserId                   String            @map("author_user_id") @db.ObjectId
  scope                          PostScope
  type                           PostType
  priority                       PostPriority      @default(NORMAL)
  
  title                          String
  slug                           String
  content                        String
  excerpt                        String?
  coverImageUrl                  String?           @map("cover_image_url")
  eventDate                      DateTime?         @map("event_date")
  location                       String?
  requiresAttendanceConfirmation Boolean           @default(false) @map("requires_attendance_confirmation")
  
  isPublished                    Boolean           @default(true) @map("is_published")
  publishedAt                    DateTime          @default(now()) @map("published_at")
  expiresAt                      DateTime?         @map("expires_at")
  
  createdAt                      DateTime          @default(now()) @map("created_at")
  updatedAt                      DateTime          @updatedAt @map("updated_at")

  jac                            Jac?              @relation(fields: [jacId], references: [id], onDelete: Cascade)
  author                         User              @relation(fields: [authorUserId], references: [id], onDelete: NoAction)
  mingaAttendances               MingaAttendance[]

  @@index([jacId])
  @@index([scope])
  @@index([type])
  @@index([isPublished])
  @@map("posts")
}

model MingaAttendance {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  postId      String    @map("post_id") @db.ObjectId
  userId      String    @map("user_id") @db.ObjectId
  jacId       String    @map("jac_id") @db.ObjectId
  attending   Boolean   @default(true)
  attended    Boolean   @default(false)
  notes       String?
  confirmedAt DateTime  @default(now()) @map("confirmed_at")

  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jac         Jac       @relation(fields: [jacId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([jacId])
  @@index([postId])
  @@map("minga_attendances")
}

// =========================================================================
// 7. PARTICIPACIÓN CIUDADANA: PQRSD Y ASAMBLEAS
// =========================================================================

model PqrsdTicket {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  ticketNumber     String       @unique @map("ticket_number")
  jacId            String       @map("jac_id") @db.ObjectId
  userId           String?      @map("user_id") @db.ObjectId
  assignedToUserId String?      @map("assigned_to_user_id") @db.ObjectId
  
  isAnonymous      Boolean      @default(false) @map("is_anonymous")
  type             PqrsdType
  status           PqrsdStatus  @default(RECEIVED)
  subject          String
  description      String
  attachments      Json         @default("[]")
  responseText     String?      @map("response_text")
  respondedAt      DateTime?    @map("responded_at")
  
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  jac              Jac          @relation(fields: [jacId], references: [id], onDelete: Cascade)
  user             User?        @relation("CitizenTickets", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo       User?        @relation("AssignedTickets", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([jacId])
  @@index([userId])
  @@index([status])
  @@map("pqrsd_tickets")
}

model Assembly {
  id                       String          @id @default(auto()) @map("_id") @db.ObjectId
  jacId                    String          @map("jac_id") @db.ObjectId
  title                    String
  description              String?
  type                     AssemblyType
  scheduledDate            DateTime        @map("scheduled_date")
  location                 String
  quorumPercentageRequired Int             @default(50) @map("quorum_percentage_required")
  quorumReached            Boolean         @default(false) @map("quorum_reached")
  status                   AssemblyStatus  @default(SCHEDULED)
  minutesPdfUrl            String?         @map("minutes_pdf_url")
  
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  jac                      Jac             @relation(fields: [jacId], references: [id], onDelete: Cascade)
  topics                   AssemblyTopic[]

  @@index([jacId])
  @@index([scheduledDate])
  @@map("assemblies")
}

model AssemblyTopic {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  assemblyId  String               @map("assembly_id") @db.ObjectId
  jacId       String               @map("jac_id") @db.ObjectId
  title       String
  description String?
  options     Json                 // [{"id": "opt-1", "label": "A favor"}, ...]
  isOpen      Boolean              @default(true) @map("is_open")
  createdAt   DateTime             @default(now()) @map("created_at")

  assembly    Assembly             @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  jac         Jac                  @relation(fields: [jacId], references: [id], onDelete: Cascade)
  votes       AssemblyVoteRecord[]

  @@index([assemblyId])
  @@index([jacId])
  @@map("assembly_topics")
}

model AssemblyVoteRecord {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  topicId          String        @map("topic_id") @db.ObjectId
  jacId            String        @map("jac_id") @db.ObjectId
  voterUserId      String        @map("voter_user_id") @db.ObjectId
  
  voteHash         String        @map("vote_hash")
  encryptedPayload String        @map("encrypted_payload")
  castAt           DateTime      @default(now()) @map("cast_at")

  topic            AssemblyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  jac              Jac           @relation(fields: [jacId], references: [id], onDelete: Cascade)
  voter            User          @relation(fields: [voterUserId], references: [id], onDelete: NoAction)

  @@unique([topicId, voterUserId])
  @@index([topicId])
  @@index([jacId])
  @@map("assembly_vote_records")
}

// =========================================================================
// 8. AUDITORÍA GLOBAL Y NOTIFICACIONES MULTICANAL
// =========================================================================

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  jacId      String?  @map("jac_id") @db.ObjectId
  userId     String?  @map("user_id") @db.ObjectId
  action     String
  entityName String   @map("entity_name")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  jac        Jac?     @relation(fields: [jacId], references: [id], onDelete: SetNull)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([jacId])
  @@index([userId])
  @@index([entityName])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  jacId             String?             @map("jac_id") @db.ObjectId
  userId            String              @map("user_id") @db.ObjectId
  channel           NotificationChannel
  title             String
  body              String
  data              Json                @default("{}")
  isRead            Boolean             @default(false) @map("is_read")
  status            String              @default("PENDING")
  externalMessageId String?             @map("external_message_id")
  createdAt         DateTime            @default(now()) @map("created_at")

  jac               Jac?                @relation(fields: [jacId], references: [id], onDelete: SetNull)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jacId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
